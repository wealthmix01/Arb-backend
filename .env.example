# Copy this file to .env and fill in your real values.
# NEVER commit your real .env to GitHub.

PORT=3001

# ── Bybit (Read + Trade only, NO withdrawal permission) ──────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_secret_here

# ── Gate.io (Read + Trade only, NO withdrawal permission) ────────────────────
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_API_SECRET=your_gateio_secret_here

# ── Binance (optional) ────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── OKX (optional) ───────────────────────────────────────────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ── Bot settings ──────────────────────────────────────────────────────────────
# How many seconds to cache price data before re-fetching
CACHE_TTL=15
# Only surface opportunities with net spread above this %
MIN_SPREAD_PCT=1.5
