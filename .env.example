# Environment variables for Arbitrage Bot

# Node Environment
NODE_ENV=development
PORT=3000

# Exchange API Keys
# Bybit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET=your_bybit_secret
BYBIT_TESTNET=false

# Bitget
BITGET_API_KEY=your_bitget_api_key
BITGET_SECRET=your_bitget_secret
BITGET_PASSPHRASE=your_bitget_passphrase

# Gate.io
GATEIO_API_KEY=your_gateio_api_key
GATEIO_SECRET=your_gateio_secret
GATEIO_UID=your_gateio_uid

# Binance (Optional)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# Kraken (Optional)
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_SECRET=your_kraken_secret

# Database
MONGODB_URI=mongodb://localhost:27017/arb-backend
REDIS_URL=redis://localhost:6379

# Arbitrage Settings
MIN_PROFIT_PERCENTAGE=0.5
PRICE_CHECK_INTERVAL=5000
MAX_POSITION_SIZE=1000
ENABLE_AUTO_TRADING=false

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Notification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ENABLE_NOTIFICATIONS=true
